{
  "manifest_version": 3,
  "name": "页面导航工具栏",
  "version": "1.0.0",
  "description": "在网页右侧提供回到顶部、上下翻页和直达底部的快捷工具栏。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/scroll-actions.js",
        "src/toolbar.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
